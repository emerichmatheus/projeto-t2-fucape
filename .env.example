# Copie para .env:  cp .env.example .env
# UID do usuário dentro dos contêineres do Airflow (Linux: rode `id -u`).
AIRFLOW_UID=50000

# Login da Web UI do Airflow (http://localhost:8080)
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
# Porta da Web UI no host (troque se a 8080 estiver ocupada)
AIRFLOW_WEB_PORT=8080

# Banco de metadados do Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Data Warehouse (exposto no host em localhost:5433)
DW_USER=dw
DW_PASSWORD=dw
DW_DB=steam_dw

# Ingestão
STEAM_APP_IDS=730,570,271590,1172470,578080,252490,1245620,413150
STEAM_MAX_PAGES=20
STEAM_LANGUAGE=brazilian
STEAM_POLITE_PAUSE=1.0
# Probabilidade (0-1) de simular um HTTP 429 numa requisição.
# Use 0.2 para demonstrar o backoff nos logs do Airflow; 0 em produção.
STEAM_SIMULATE_429_RATE=0
